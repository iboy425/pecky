*.py[cod]
.venv/
venv/

# Locally captured motion data and trained artifacts
data/**/*.csv
data/**/*.parquet
models/
*.joblib

# Local Arduino build output
build/
*.bin
*.elf
*.map

# OS/editor files
Thumbs.db
.vscode/
.idea/

